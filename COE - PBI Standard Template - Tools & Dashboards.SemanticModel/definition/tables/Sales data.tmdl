table 'Sales data'
	lineageTag: 83e761fa-fc5c-4cb5-b7a1-43acfedef152

	measure Costs/Sales =
			
			DIVIDE(SUM('Sales data'[COGS]), SUM('Sales data'[ Sales]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d4e8f76d-b8f8-44b5-9920-b137bd80d9bd

		changedProperty = FormatString

	measure 'Net Margin' =
			
			DIVIDE([Sales-Costs], SUM('Sales data'[ Sales]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 25eba904-aa88-41c4-aadb-34a2d06f6f38

		changedProperty = FormatString

	measure Sales-Costs =
			
			SUM('Sales data'[ Sales]) - SUM('Sales data'[COGS])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: ff43bcd9-4e4f-4f2b-903d-a8ef630f3daf

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg Sales by Country' =
			
			AVERAGEX(
				KEEPFILTERS(VALUES('Sales data'[Country])),
				CALCULATE(SUM('Sales data'[ Sales]))
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: cc44e43b-d638-42bb-b05c-d94a7a984d8c

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg Sales by Product' =
			
			AVERAGEX(
				KEEPFILTERS(VALUES('Sales data'[Product])),
				CALCULATE(SUM('Sales data'[ Sales]))
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: cbc6d9c0-1a24-4722-819c-96696fc2f329

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

