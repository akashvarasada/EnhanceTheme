	column Quarters =
			SWITCH(
			  TRUE,
			  ISBLANK('Sales data'[Month Name]),
			  "(Blank)",
			  'Sales data'[Month Name] IN {"February",
			    "January",
			    "March"},
			  "Q1",
			  'Sales data'[Month Name] IN {"April",
			    "June",
			    "May"},
			  "Q2",
			  'Sales data'[Month Name] IN {"August",
			    "July",
			    "September"},
			  "Q3",
			  'Sales data'[Month Name] IN {"December",
			    "November",
			    "October"},
			  "Q4",
			  'Sales data'[Month Name]
			)
		lineageTag: 685d9627-7b70-4c55-8865-21382f93d5bf
		summarizeBy: none

